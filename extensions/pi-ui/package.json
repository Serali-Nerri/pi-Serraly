{
  "name": "pi-ui",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "Tool cards, Thinking, shell, /ccstyle and /context for the private pi-Serraly workspace",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./dist/pi-ui.js"
    ]
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "check": "tsc -p tsconfig.json",
    "pack:check": "node ../../scripts/build-package.mjs --check",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "serraly": {
    "build": {
      "kind": "bundle",
      "entry": "./src/index.ts"
    },
    "licenses": [
      "licenses/README.md",
      "licenses/claude-style-tools-LICENSE",
      "licenses/claude-style-tools-THIRD_PARTY_NOTICES.md",
      "licenses/pi-session-ui-LICENSE",
      "licenses/pi-session-ui-UPSTREAM.md",
      "licenses/LICENSES/marked.txt",
      "licenses/LICENSES/pi-cc-extensions.txt",
      "licenses/LICENSES/pi-compact-thinking.txt"
    ],
    "test": {
      "directory": "test"
    }
  },
  "devDependencies": {
    "pi-ui-kit": "0.1.0",
    "pi-config-core": "0.1.0",
    "pi-apply-patch-protocol": "0.1.0"
  }
}
