{
  "name": "context-view",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "Standalone /context Usage estimate, frozen Initial injections and previews",
  "license": "MIT",
  "author": "Dmitry Makarov",
  "engines": { "node": ">=22.19.0" },
  "files": ["dist/", "README.md"],
  "pi": { "extensions": ["./dist/context-view.js"] },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "check": "tsc -p tsconfig.json",
    "pack:check": "node ../../scripts/build-package.mjs --check",
    "prepack": "npm run build",
    "test:raw": "node --test --test-concurrency=1 --test-timeout=20000 test/*.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": { "optional": true },
    "@earendil-works/pi-tui": { "optional": true }
  },
  "devDependencies": { "pi-config-core": "0.1.0" },
  "serraly": {
    "build": { "kind": "bundle", "entry": "./src/index.ts" },
    "licenses": ["LICENSE", "UPSTREAM.md"],
    "test": { "directory": "test", "command": "test:raw", "denyNetwork": true }
  }
}
