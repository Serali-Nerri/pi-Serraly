{
  "name": "pi-subagents",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Native Pi SDK subagent sessions for the private pi-Serraly workspace",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "check": "tsc --noEmit",
    "test": "node ../../scripts/test-package.mjs",
    "test:raw": "vitest run",
    "pack:check": "node ../../scripts/build-package.mjs --check",
    "prepack": "npm run build && npm run pack:check"
  },
  "devDependencies": {
    "pi-ui-kit": "0.1.0",
    "pi-config-core": "0.1.0",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "serraly": {
    "build": {
      "kind": "bundle",
      "entry": "./src/index.ts"
    },
    "licenses": [
      "LICENSE",
      "UPSTREAM.md"
    ],
    "test": {
      "directory": "test",
      "command": "test:raw",
      "denyNetwork": true
    }
  }
}
