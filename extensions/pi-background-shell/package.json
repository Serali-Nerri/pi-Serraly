{
  "name": "pi-background-shell",
  "version": "0.2.1",
  "description": "Pi extension for background shell processes, bounded logs, task UI, completion notifications, and same-process reload handoff.",
  "type": "module",
  "license": "ISC",
  "author": "Ismail <ismailsalikhodjaev@gmail.com>",
  "keywords": [
    "pi-package",
    "pi-extension",
    "background-tasks",
    "shell",
    "task-manager"
  ],
  "files": [
    "dist/",
    "extensions/",
    "src/",
    "README.md",
    "TESTING.md",
    "LICENSE",
    "UPSTREAM.md",
    "CHANGELOG.md",
    "docs/"
  ],
  "scripts": {
    "build:runtime": "node ../../scripts/build-package.mjs",
    "typecheck": "tsc --noEmit",
    "test:type-safety": "node scripts/test-isolated.mjs --test tests/package/type-safety.test.ts",
    "test:unit": "node scripts/test-isolated.mjs --test tests/unit/**/*.test.ts",
    "test:sdk": "node scripts/test-isolated.mjs --test --test-concurrency=1 tests/sdk/**/*.test.ts",
    "test:rpc": "node scripts/test-isolated.mjs --test tests/rpc/**/*.test.ts",
    "test:component": "node scripts/test-isolated.mjs --test tests/component/**/*.test.ts",
    "test:package": "node scripts/test-isolated.mjs --test tests/package/**/*.test.ts",
    "test": "npm run test:unit && npm run test:sdk && npm run test:rpc && npm run test:component && npm run test:package",
    "test:windows": "node scripts/test-isolated.mjs --test tests/windows/**/*.test.ts",
    "test:agent-loop": "node scripts/test-isolated.mjs --test --test-concurrency=1 tests/scripted-provider/**/*.test.ts",
    "test:full": "npm run test && npm run test:agent-loop",
    "smoke": "node scripts/test-isolated.mjs scripts/smoke.ts",
    "test:compat": "npm run smoke",
    "docs:generate": "node scripts/docs/generate.mjs",
    "docs:verify": "node scripts/docs/verify.mjs",
    "test:docs": "node scripts/test-isolated.mjs --test tests/unit/docs-gate.test.ts tests/package/docs-contract.test.ts",
    "payload:check": "node scripts/check-package-payload.mjs",
    "prepack": "npm run docs:verify && npm run build",
    "check": "npm run typecheck && npm run docs:verify",
    "build": "node ../../scripts/build-package.mjs",
    "verify": "npm run build && npm run check && npm run test:full && npm run smoke",
    "pack:check": "node ../../scripts/build-package.mjs --check"
  },
  "pi": {
    "extensions": [
      "./dist/extensions/background-tasks.js"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0",
    "@types/node": "24.10.1",
    "tsx": "4.23.12",
    "typebox": "1.3.27",
    "typescript": "5.9.3",
    "pi-ui-kit": "0.1.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "private": true,
  "serraly": {
    "build": {
      "kind": "script",
      "script": "./scripts/build-runtime.mjs",
      "verifyArtifact": "./scripts/check-package-payload.mjs",
      "bundles": {
        "src/ui/tool-cards.ts": {
          "output": "dist/src/ui/tool-cards.js",
          "packages": [
            "pi-ui-kit"
          ]
        }
      }
    },
    "licenses": [
      "LICENSE",
      "UPSTREAM.md"
    ],
    "test": {
      "directory": "tests",
      "command": "test:full"
    }
  }
}
