      {
        "name": "command",
        "type": "string",
        "required": true
      },
      {
        "name": "timeoutSeconds",
        "type": "number | undefined",
        "required": false
      },
      {
        "name": "notifyOnCompletion",
        "type": "boolean",
        "required": true
      },
      {
        "name": "triggerOnCompletion",
        "type": "boolean",
        "required": true
      }
    ]
  },
  "contracts": {
    "statuses": [
      "running",
      "completed",
      "failed",
      "killed"
    ],
    "log_bytes": {
      "MAX_LOG_BYTES": 51200,
      "DEFAULT_LOG_BYTES": 51200
