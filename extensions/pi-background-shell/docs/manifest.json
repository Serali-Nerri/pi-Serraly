{
  "schema_version": "pi-background-shell.docs-manifest.v1",
  "package": {
    "name": "pi-background-shell",
    "version": "0.2.1",
    "entry": "./dist/extensions/background-tasks.js",
    "node": ">=22.19.0",
    "verified_host": "1.1.0",
    "typebox": "1.3.27"
  },
  "public_surfaces": {
    "tools": [
      {
        "id": "tool:bg_kill",
        "name": "bg_kill",
        "label": "Background Kill",
        "description": "Stop a running background task by ID. Fails loudly if the task is unknown or already finished.",
        "parameters": {
          "type": "object",
          "properties": {
            "taskId": {
              "type": "string",
              "description": "Task ID or unambiguous prefix to stop"
            }
          },
          "required": [
            "taskId"
          ]
        },
        "availability": "always",
        "source": "src/extension.ts:981"
      },
      {
        "id": "tool:bg_logs",
        "name": "bg_logs",
        "label": "Background Logs",
        "description": "Read bounded output from a background task for deliberate inspection; this is not a waiting primitive. Output is capped at 50.0KB for model safety and points to the full output file when truncated.",
        "parameters": {
          "type": "object",
          "properties": {
            "taskId": {
              "type": "string",
              "description": "Task ID or unambiguous prefix"
            },
            "maxBytes": {
              "type": "number",
              "description": "Maximum bytes to return, capped at 50.0KB. Default: 50.0KB."
            },
            "tail": {
              "type": "boolean",
              "description": "Read the tail of the log when true, head when false. Default: true."
            }
          },
          "required": [
            "taskId"
          ]
        },
        "availability": "always",
        "source": "src/extension.ts:938"
      },
      {
        "id": "tool:bg_run",
        "name": "bg_run",
        "label": "Background Run",
        "description": "Start a named long-running shell command in the background; returns immediately with task ID, PID, and output path. Default terminal notification starts a follow-up turn; do not poll or sleep merely to wait. Output is stored in .pi/tasks, with model-visible log reads capped at 50 KiB. Commands run with local permissions, not in a sandbox.",
        "description_suffix": "BG_RUN_DESCRIPTION + shellPolicyDescription(shellPolicy): append the activation-selected executable, argv and command syntax; never extract a local shell path or execute extension code.",
        "parameters": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "Short human-readable task name shown in the bg footer dock. Required; use 2-6 words, not the raw command."
            },
            "command": {
              "type": "string",
              "description": "Required shell command; runs in the session working directory."
            },
            "description": {
              "type": "string",
              "description": "Longer human-readable task context. Default: none."
            },
            "timeoutSeconds": {
              "type": "number",
              "minimum": 1,
              "maximum": 2147483,
              "description": "Timeout in seconds, rounded down to whole seconds; task fails and is killed when exceeded. Default: no timeout."
            },
            "notifyOnCompletion": {
              "type": "boolean",
              "description": "Deliver a terminal notification. Default: true. When false, triggerOnCompletion has no effect."
            },
            "triggerOnCompletion": {
              "type": "boolean",
              "description": "Automatically start a follow-up agent turn on terminal notification. Default: true; inactive when notifyOnCompletion is false."
            },
            "surviveReload": {
              "type": "boolean",
              "description": "Retain this exact shell execution across a real same-process Pi reload. Default: false. Does not survive exit, restart, or session replacement."
            }
          },
          "required": [
            "name",
            "command"
          ],
          "additionalProperties": false
        },
        "availability": "always",
        "source": "src/extension.ts:857"
      },
      {
        "id": "tool:bg_status",
        "name": "bg_status",
        "label": "Background Status",
        "description": "Inspect one background task or list all running/recent background tasks. This is a point-in-time inspection tool, not a waiting primitive.",
        "parameters": {
          "type": "object",
          "properties": {
            "taskId": {
              "type": "string",
              "description": "Optional task ID or unambiguous prefix. If omitted, all running/recent tasks are returned."
            }
          }
        },
        "availability": "always",
        "source": "src/extension.ts:901"
      }
    ],
    "commands": [
      {
        "id": "command:bg",
        "name": "bg",
        "availability": "always",
        "source": "src/extension.ts:704",
        "description": "Start a tracked shell command: /bg [--survive-reload] [--name \"Task name\"] <command>"
      },
      {
        "id": "command:bg-clear",
        "name": "bg-clear",
        "availability": "always",
        "source": "src/extension.ts:746",
        "description": "Clear finished background task footer notices"
      },
      {
        "id": "command:bg-tasks",
        "name": "bg-tasks",
        "availability": "always",
        "source": "src/extension.ts:738",
        "description": "Open the background task manager UI"
      },
      {
        "id": "command:jobs",
        "name": "jobs",
        "availability": "always",
        "source": "src/extension.ts:780",
        "description": "List running and recent background tasks"
      },
      {
        "id": "command:kill",
        "name": "kill",
        "availability": "always",
        "source": "src/extension.ts:824",
        "description": "Stop a running background task: /kill <id>"
      },
      {
        "id": "command:logs",
        "name": "logs",
        "availability": "always",
        "source": "src/extension.ts:793",
        "description": "Show bounded output from a background task: /logs <id> [maxBytes]"
      },
      {
        "id": "command:tasks",
        "name": "tasks",
        "availability": "always",
        "source": "src/extension.ts:730",
        "description": "Open the background task manager UI"
      }
    ],
    "shortcuts": [
      {
        "id": "shortcut:ctrl+alt+b",
        "name": "ctrl+alt+b",
        "availability": "dock:ctrl+alt+b",
        "source": "src/extension.ts:764",
        "description": "Open focused background task footer dock"
      },
      {
        "id": "shortcut:ctrl+alt+c",
        "name": "ctrl+alt+c",
        "availability": "always",
        "source": "src/extension.ts:772",
        "description": "Clear finished background task footer notices (terminal-dependent fallback for /bg-clear)"
      },
      {
        "id": "shortcut:shift+down",
        "name": "shift+down",
        "availability": "dock:shift+down",
        "source": "src/extension.ts:755",
        "description": "Open focused background task footer dock"
      }
    ],
    "renderers": [
      {
        "id": "renderer:background-task-notification",
        "name": "background-task-notification",
        "availability": "always",
        "source": "src/extension.ts:606"
      }
    ]
  },
  "public_surface_ids": [
    "command:bg",
    "command:bg-clear",
    "command:bg-tasks",
    "command:jobs",
    "command:kill",
    "command:logs",
    "command:tasks",
    "renderer:background-task-notification",
    "shortcut:ctrl+alt+b",
