    "BG_REQUEST_CHANNEL": "pi-background-shell:request:v2",
    "BG_RESPONSE_CHANNEL": "pi-background-shell:response:v2",
    "BG_TERMINAL_CHANNEL": "pi-background-shell:terminal:v2",
