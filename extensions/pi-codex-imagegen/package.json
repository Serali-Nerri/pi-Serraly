{
  "name": "pi-codex-imagegen",
  "version": "0.0.11",
  "private": true,
  "type": "module",
  "description": "Image generation and editing with OpenAI and Codex authentication",
  "license": "MIT AND Apache-2.0",
  "author": "Igor Warzocha",
  "engines": { "node": ">=22.19.0" },
  "files": ["dist/", "README.md"],
  "pi": { "extensions": ["./dist/pi-codex-imagegen.js"] },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "check": "tsc -p tsconfig.json",
    "pack:check": "node ../../scripts/build-package.mjs --check",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": { "optional": true },
    "@earendil-works/pi-coding-agent": { "optional": true },
    "@earendil-works/pi-tui": { "optional": true },
    "typebox": { "optional": true }
  },
  "devDependencies": { "proxy-from-env": "2.1.0", "undici": "8.12.2" },
  "serraly": {
    "build": { "kind": "bundle", "entry": "./index.ts", "cjsRequire": true },
    "licenses": ["LICENSE", "UPSTREAM.md", "licenses/openai-codex-Apache-2.0.txt"],
    "bundledLicenses": [
      { "package": "undici", "file": "LICENSE", "to": "licenses/undici-MIT.txt" },
      { "package": "proxy-from-env", "file": "LICENSE", "to": "licenses/proxy-from-env-MIT.txt" }
    ],
    "test": { "directory": "test" }
  }
}
