{
  "name": "pi-ask-user-question",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "Structured ask_user_question dialog with previews, notes and an RPC dialog fallback",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./dist/pi-ask-user-question.js"
    ]
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "check": "tsc -p tsconfig.json",
    "pack:check": "node ../../scripts/build-package.mjs --check",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "pi-config-core": "0.1.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "serraly": {
    "build": {
      "kind": "bundle",
      "entry": "./src/index.ts"
    },
    "licenses": [
      "LICENSE",
      "UPSTREAM.md"
    ],
    "test": {
      "directory": "test"
    }
  }
}
