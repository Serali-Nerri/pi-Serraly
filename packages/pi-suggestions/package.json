{
  "name": "@howaboua/pi-suggestions",
  "version": "0.0.4",
  "description": "Editable next-prompt suggestions for Pi",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IgorWarzocha/howaboua-pi-stuff.git",
    "directory": "packages/pi-suggestions"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "suggestions"
  ],
  "files": [
    "index.ts",
    "src",
    "README.md",
    "UPSTREAM.md",
    "tsconfig.json",
    "LICENSE",
    "CHANGELOG.md",
    "CHANGELOG.local.md",
    "!**/AGENTS.md"
  ],
  "main": "index.ts",
  "exports": "./index.ts",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.5.0",
    "@earendil-works/pi-ai": ">=1.3.0",
    "@earendil-works/pi-tui": ">=1.3.0"
  },
  "scripts": {
    "check": "bun run lint && bun run typecheck",
    "lint": "bun run format:check && oxlint --type-aware",
    "typecheck": "tsrs --noEmit",
    "format:check": "oxfmt --check '**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx,json,jsonc,json5,css}'"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.6.0",
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@earendil-works/pi-tui": "1.6.0"
  }
}
