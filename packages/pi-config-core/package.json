{
  "name": "pi-config-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bounded, atomic JSON configuration I/O for the private pi-Serraly workspace",
  "license": "Apache-2.0",
  "engines": { "node": ">=22.19.0" },
  "files": ["dist/", "README.md"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "check": "tsc -p tsconfig.json",
    "pack:check": "node ../../scripts/build-package.mjs --check",
    "prepack": "npm run build && npm run pack:check"
  },
  "serraly": {
    "build": { "kind": "tsc", "project": "./tsconfig.build.json" },
    "licenses": ["licenses/README.md", "licenses/claude-style-tools-LICENSE", "UPSTREAM.md"],
    "test": { "directory": "test" }
  }
}
