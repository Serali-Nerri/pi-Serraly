{
	"name": "@howaboua/pi-browser",
	"version": "0.0.13",
	"description": "Logged-in browser inspection and control for Pi, Code Mode and Notebook Mode.",
	"type": "module",
	"license": "MIT",
	"author": "Igor Warzocha",
	"homepage": "https://github.com/IgorWarzocha/howaboua-pi-stuff/tree/main/packages/pi-browser#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/IgorWarzocha/howaboua-pi-stuff.git",
		"directory": "packages/pi-browser"
	},
	"bugs": {
		"url": "https://github.com/IgorWarzocha/howaboua-pi-stuff/issues"
	},
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi",
		"browser",
		"chrome",
		"cdp",
		"code-mode"
	],
	"files": [
		"dist/**/*.js",
		"dist/**/*.d.ts",
		"extension.ts",
		"index.ts",
		"remote-worker.ts",
		"src",
		"README.md",
		"UPSTREAM.md",
		"LICENSE",
		"CHANGELOG.md",
		"tsconfig.json",
		"biome.json"
	],
	"scripts": {
		"build:voice-api": "tsc -p tsconfig.voice-api.json",
		"build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && bun build remote-worker.ts --target=node --format=esm --outfile=dist/remote-worker.js --banner='// @howaboua/pi-browser managed worker'",
		"check": "bun run lint && bun run typecheck",
		"typecheck": "tsgo --noEmit",
		"lint": "biome check ."
	},
	"peerDependencies": {
		"@howaboua/pi-codex-conversion": ">=4.0.9",
		"@earendil-works/pi-ai": ">=1.0.0",
		"@earendil-works/pi-coding-agent": ">=1.5.0",
		"typebox": "*",
		"@earendil-works/pi-tui": ">=1.0.0"
	},
	"peerDependenciesMeta": {
		"@howaboua/pi-codex-conversion": {
			"optional": true
		}
	},
	"devDependencies": {
		"@howaboua/pi-codex-conversion": "4.0.9",
		"@biomejs/biome": "^2.6.3",
		"@earendil-works/pi-ai": "1.5.0",
		"@earendil-works/pi-coding-agent": "1.5.0",
		"@types/node": "^26.6.5",
		"typebox": "1.3.27",
		"typescript": "^7.0.2"
	},
	"pi": {
		"extensions": [
			"./extension.ts"
		]
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"bin": {
		"pi-browser-worker": "./dist/remote-worker.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		"./voice-start": {
			"types": "./dist/src/browser/voice-start.d.ts",
			"import": "./dist/src/browser/voice-start.js"
		},
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./extension": {
			"types": "./dist/extension.d.ts",
			"import": "./extension.ts"
		}
	}
}
