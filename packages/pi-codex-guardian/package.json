{
  "name": "@howaboua/pi-codex-guardian",
  "version": "0.0.1",
  "description": "Action-bound Codex Guardian approval for Pi, Code Mode and Notebook Mode.",
  "type": "module",
  "license": "MIT AND Apache-2.0",
  "author": "Igor Warzocha",
  "homepage": "https://github.com/IgorWarzocha/howaboua-pi-stuff/tree/main/packages/pi-codex-guardian#readme",
  "repository": {
    "type": "git",
