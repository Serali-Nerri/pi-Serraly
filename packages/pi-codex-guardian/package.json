    "directory": "packages/pi-codex-guardian"
  },
  "bugs": {
    "url": "https://github.com/IgorWarzocha/howaboua-pi-stuff/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "codex",
    "approval",
    "guardian"
  ],
  "files": [
    "index.ts",
    "src",
    "policy",
    "README.md",
    "UPSTREAM.md",
    "PROTOCOL.md",
    "LICENSE",
    "CHANGELOG.md",
    "CHANGELOG.local.md",
    "tsconfig.json"
  ],
  "scripts": {
    "check": "bun run lint && bun run typecheck",
    "typecheck": "tsrs --noEmit",
    "lint": "bun run format:check && oxlint --type-aware",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "format:check": "oxfmt --check '**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx,json,jsonc,json5,css}'"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.0.0",
    "@earendil-works/pi-coding-agent": ">=1.5.0",
    "@howaboua/pi-codex-conversion": ">=5.0.1",
    "@earendil-works/pi-tui": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@howaboua/pi-codex-conversion": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@howaboua/pi-codex-conversion": "5.0.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "oxfmt": "^0.78.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "index.ts",
  "exports": "./index.ts"
