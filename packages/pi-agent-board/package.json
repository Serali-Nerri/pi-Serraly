{
  "name": "@howaboua/pi-agent-board",
  "version": "0.0.9",
  "description": "Standalone agent message boards and a read-only browser viewer for Pi",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IgorWarzocha/howaboua-pi-stuff.git",
    "directory": "packages/pi-agent-board"
  },
  "files": [
    "index.ts",
    "src",
    "dist",
    "README.md",
    "UPSTREAM.md",
    "INTEGRATION.md",
    "LICENSE",
    "tsconfig.json",
    "CHANGELOG.md",
    "runtime.ts",
    "scripts",
    "tsconfig.viewer.json"
  ],
  "main": "index.ts",
  "exports": {
    ".": "./index.ts",
    "./runtime": "./runtime.ts",
    "./integration": "./src/board/integration.ts"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "node scripts/build-viewer.mjs",
    "check": "bun run lint && bun run typecheck",
    "lint": "bun run format:check && oxlint --type-aware",
    "typecheck": "tsrs --noEmit",
    "format:check": "oxfmt --check '**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx,json,jsonc,json5,css}'"
  },
  "dependencies": {
    "@earendil-works/pi-schema": "1.6.0",
    "dompurify": "3.4.17",
    "marked": "18.2.0",
    "unicode-case-folding": "1.1.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.1.0",
    "@earendil-works/pi-coding-agent": ">=1.5.0",
    "@earendil-works/pi-tui": ">=1.1.0",
    "@howaboua/pi-codex-conversion": ">=5.0.2"
  },
  "peerDependenciesMeta": {
    "@howaboua/pi-codex-conversion": {
      "optional": true
    }
  },
  "devDependencies": {
    "@howaboua/pi-codex-conversion": "5.0.2"
  }
}
