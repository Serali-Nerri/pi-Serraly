{
	"name": "@howaboua/pi-shepherdr",
	"version": "1.0.1",
	"description": "Persistent blocking and asynchronous Pi agents through Herdr.",
	"type": "module",
	"license": "MIT",
	"author": "Igor Warzocha",
	"homepage": "https://github.com/IgorWarzocha/howaboua-pi-stuff/tree/main/packages/pi-shepherdr#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/IgorWarzocha/howaboua-pi-stuff.git",
		"directory": "packages/pi-shepherdr"
	},
	"bugs": {
		"url": "https://github.com/IgorWarzocha/howaboua-pi-stuff/issues"
	},
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi",
		"herdr",
		"shepherdr",
		"agents",
		"orchestration"
	],
	"files": [
		"index.ts",
		"worker-api.ts",
		"src",
		"profiles",
		"README.md",
		"UPSTREAM.md",
		"LICENSE",
		"tsconfig.json",
		"biome.json",
		"CHANGELOG.md"
	],
	"scripts": {
		"check": "bun run lint && bun run typecheck",
		"test": "node --import tsx --test tests/*.test.mjs",
		"typecheck": "tsgo --noEmit",
		"lint": "biome check .",
		"format": "biome check --write ."
	},
	"peerDependencies": {
		"@howaboua/pi-codex-conversion": ">=5.0.0",
		"@earendil-works/pi-ai": ">=1.1.0",
		"@earendil-works/pi-coding-agent": ">=1.5.0",
		"@earendil-works/pi-tui": ">=1.1.0"
	},
	"peerDependenciesMeta": {
		"@howaboua/pi-codex-conversion": {
			"optional": true
		}
	},
	"devDependencies": {
		"@howaboua/pi-agent-board": "0.0.7",
		"@howaboua/pi-notes-compaction": "0.0.17",
		"@howaboua/pi-codex-conversion": "5.0.0",
		"@biomejs/biome": "^2.6.6",
		"@earendil-works/pi-ai": "1.5.2",
		"@earendil-works/pi-coding-agent": "1.5.2",
		"@earendil-works/pi-tui": "1.5.2",
		"@types/node": "^26.6.6",
		"typescript": "^7.0.2"
	},
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"main": "index.ts",
	"exports": {
		".": "./index.ts",
		"./worker-api": "./worker-api.ts"
	},
	"dependencies": {
		"@earendil-works/pi-schema": "1.5.2"
	}
}
