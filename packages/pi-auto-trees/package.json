{
  "name": "@howaboua/pi-auto-trees",
  "version": "0.1.19",
  "description": "A Pi package that adds /marker and /end commands for incremental long-running coding sessions.",
  "type": "module",
  "license": "MIT",
  "author": "pi-auto-trees contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IgorWarzocha/howaboua-pi-stuff.git",
    "directory": "packages/pi-auto-trees"
  },
  "bugs": {
    "url": "https://github.com/IgorWarzocha/howaboua-pi-stuff/issues"
  },
  "homepage": "https://github.com/IgorWarzocha/howaboua-pi-stuff/tree/main/packages/pi-auto-trees#readme",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "coding-agent",
    "slash-command",
    "session-management"
  ],
  "engines": {
    "node": ">=20.6.0"
  },
  "files": [
    "index.ts",
    "src",
    "README.md",
    "UPSTREAM.md",
    "LICENSE",
    "tsconfig.json",
    "CHANGELOG.md",
    "CHANGELOG.local.md"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.6.1",
    "@earendil-works/pi-tui": ">=1.6.1",
    "@howaboua/pi-codex-conversion": ">=5.1.2"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@earendil-works/pi-coding-agent": "1.6.1",
    "@howaboua/pi-codex-conversion": "5.1.2",
    "oxfmt": "^0.78.0"
  },
  "scripts": {
    "typecheck": "tsrs --noEmit",
    "check": "bun run lint && bun run typecheck",
    "lint": "bun run format:check && oxlint --type-aware",
    "format": "oxfmt --write '**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx,json,jsonc,json5,css}'",
    "format:check": "oxfmt --check '**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx,json,jsonc,json5,css}'"
  },
  "overrides": {
    "uuid": "14.0.0"
  },
  "main": "index.ts",
  "exports": "./index.ts",
  "peerDependenciesMeta": {
    "@howaboua/pi-codex-conversion": {
      "optional": true
    }
  }
}
