{
  "name": "pi-serraly",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Independently selectable private Pi extensions.",
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "extensions/*",
    "packages/*"
  ],
  "pi": {
    "extensions": [],
    "skills": [],
    "prompts": [],
    "themes": []
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "build": "node scripts/build.mjs",
    "test": "node scripts/test.mjs",
    "pack:check": "node scripts/pack-check.mjs",
    "check:package-versions": "node scripts/check-package-versions.mjs",
    "verify": "npm run check && npm test && npm run pack:check",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-agent-core": "1.0.0",
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-tui": "1.0.0",
    "@types/node": "24.10.1",
    "esbuild": "0.28.2",
    "tsx": "4.23.12",
    "typebox": "1.3.27",
    "typescript": "5.9.3"
  }
}
