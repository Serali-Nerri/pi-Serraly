{
  "name": "pi-serraly",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Six independently selectable private Pi extensions.",
  "engines": { "node": ">=22.19.0" },
  "workspaces": ["modules/*"],
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node scripts/test.mjs",
    "build": "node scripts/build.mjs",
    "verify": "npm run check && npm test",
    "release": "node scripts/release.mjs",
    "migrate": "node scripts/migrate.mjs"
  },
  "pi": {
    "extensions": [
      "./dist/pi-ui/index.js",
      "./dist/pi-ask-user-question/index.js",
      "./dist/pi-loop/index.js",
      "./dist/pi-tools/index.js",
      "./dist/pi-background-shell/index.js",
      "./dist/pi-docparser/index.js"
    ]
  },
  "dependencies": { "@llamaindex/liteparse": "2.10.1" },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.99.2",
    "@earendil-works/pi-agent-core": "0.99.2",
    "@earendil-works/pi-coding-agent": "0.99.2",
    "@earendil-works/pi-tui": "0.99.2",
    "@types/node": "24.10.1",
    "esbuild": "0.28.2",
    "diff": "8.0.4",
    "oxfmt": "0.49.0",
    "oxlint": "1.76.0",
    "proper-lockfile": "4.1.2",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typebox": "1.3.27"
  }
}
